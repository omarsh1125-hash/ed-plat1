# ---- Database ----
# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edu_platform?schema=public"

# ---- Auth (NextAuth) ----
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production-please-use-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# ---- Storage ----
# "local"  -> files saved to ./public/uploads (default, no cloud account needed)
# "s3"     -> S3-compatible object storage (fill the S3_* vars below)
STORAGE_DRIVER="local"
LOCAL_UPLOAD_DIR="public/uploads"
NEXT_PUBLIC_UPLOAD_BASE_URL="/uploads"

# Only required when STORAGE_DRIVER="s3"
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# ---- Payments (stub, Stripe-ready) ----
# "stub"   -> mock checkout that grants access immediately (no keys needed)
# "stripe" -> real Stripe (fill keys below) — adapter ready for future wiring
PAYMENTS_DRIVER="stub"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ---- Platform ----
NEXT_PUBLIC_PLATFORM_NAME="EduPlatform"
NEXT_PUBLIC_DEFAULT_LOCALE="en"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

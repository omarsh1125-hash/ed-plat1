  "faqItems": [
    { "q": "Is the platform available in Arabic and English?", "a": "Yes. Every page, button, and course supports both Arabic (RTL) and English (LTR). You can switch language anytime from the top menu." },
    { "q": "Are there free courses?", "a": "Yes, many courses are free. Paid courses are clearly marked with their price." },
    { "q": "Do I get a certificate?", "a": "When you complete all lessons in a course, a verifiable certificate is generated automatically." },
    { "q": "Can I learn on mobile?", "a": "Absolutely. The platform is fully responsive and works great on phones, tablets, and desktops." },
    { "q": "How do I track my progress?", "a": "Your dashboard shows progress for each course and lets you continue from your last lesson." }

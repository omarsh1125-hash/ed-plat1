  "faqItems": [
    { "q": "هل المنصة متوفّرة بالعربية والإنجليزية؟", "a": "نعم. كل صفحة وزر ودورة تدعم العربية (من اليمين إلى اليسار) والإنجليزية (من اليسار إلى اليمين). يمكنك تبديل اللغة في أي وقت من القائمة العلوية." },
    { "q": "هل توجد دورات مجانية؟", "a": "نعم، العديد من الدورات مجانية. الدورات المدفوعة محدّدة بوضوح مع سعرها." },
    { "q": "هل أحصل على شهادة؟", "a": "عند إكمالك جميع دروس الدورة، تُنشأ شهادة قابلة للتحقّق تلقائياً." },
    { "q": "هل يمكنني التعلّم عبر الجوّال؟", "a": "بالتأكيد. المنصة متجاوبة بالكامل وتعمل بشكل رائع على الهواتف والأجهزة اللوحية وأجهزة سطح المكتب." },
    { "q": "كيف أتتبّع تقدّمي؟", "a": "تعرض لوحة التحكم الخاصة بك التقدّم في كل دورة وتتيح لك المتابعة من آخر درس." }
  ],
